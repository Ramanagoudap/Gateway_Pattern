{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ApiGateway",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ApiGateway/bin/Debug/net10.0/ApiGateway.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ApiGateway",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5172"
      },
      "console": "internalConsole"
    },
    {
      "name": "Orders.Service",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Orders.Service/bin/Debug/net10.0/Orders.Service.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Orders.Service",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5180"
      },
      "console": "internalConsole"
    },
    {
      "name": "Notifications.Service",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Notifications.Service/bin/Debug/net10.0/Notifications.Service.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Notifications.Service",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5181"
      },
      "console": "internalConsole"
    }
  ],
  "compounds": [
    {
      "name": "All Services",
      "configurations": [
        "Notifications.Service",
        "Orders.Service",
        "ApiGateway"
      ],
      "stopAll": true,
      "preLaunchTask": "build"
    }
  ]
}
