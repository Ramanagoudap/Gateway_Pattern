{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Gateway": {
    "CacheAbsoluteExpirationMinutes": 2,
    "IdempotencyInProgressSeconds": 60,
    "IdempotencyResultHours": 24,
    "ProxiedPathPrefixes": [
      "/api/v1/orders",
      "/api/v1/notifications"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notifications",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orders": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5180/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      },
      "notifications": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5181/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      }
    }
  }
}
